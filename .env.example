# Copy to .env and adjust. Never commit .env.
NF_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/notify_flow
NF_QUEUE_BACKEND=kafka            # kafka | sqs
NF_KAFKA_BOOTSTRAP=localhost:9092
NF_ORCHESTRATOR=temporal          # temporal | stepfunctions
NF_TEMPORAL_ADDRESS=localhost:7233
NF_LLM_PROVIDER=mock              # mock | ollama | anthropic
NF_LLM_MODEL=mock-copywriter-1
NF_LLM_BASE_URL=http://localhost:11434
NF_ANTHROPIC_API_KEY=             # only for NF_LLM_PROVIDER=anthropic
NF_SQS_QUEUE_URL=
NF_AWS_ENDPOINT_URL=              # e.g. http://localhost:4566 for LocalStack
NF_ENGAGEMENT_WAIT_S=172800
NF_QUIET_HOURS_ENABLED=true
NF_MEMBER_FREQUENCY_CAP_24H=10   # distinct events across all campaigns; 0 disables
NF_API_BEARER_TOKEN=change-me    # inject from a secret manager outside local development
NF_CHANNEL_MODEL_EXPERIMENT_PERCENT=50  # stable member-level model-vs-rules split
