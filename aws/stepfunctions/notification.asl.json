{
  "Comment": "notify-flow member notification: the Step Functions twin of MemberNotificationWorkflow. ${...} placeholders are filled via DefinitionSubstitutions (see aws/README.md).",
  "StartAt": "PlanNotification",
  "States": {
    "PlanNotification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {"FunctionName": "${PlanFunctionArn}", "Payload.$": "$"},
      "ResultSelector": {"plan.$": "$.Payload"},
      "ResultPath": "$.planResult",
      "Retry": [{"ErrorEquals": ["States.TaskFailed", "Lambda.ServiceException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 1, "BackoffRate": 2.0, "MaxAttempts": 6, "JitterStrategy": "FULL"}],
      "Next": "ShouldSend"
    },
    "ShouldSend": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.planResult.plan.skip", "BooleanEquals": true, "Next": "Skipped"}],
      "Default": "WaitForQuietHours"
    },
    "Skipped": {"Type": "Succeed"},
    "WaitForQuietHours": {
      "Type": "Wait",
      "TimestampPath": "$.planResult.plan.send_after_iso",
      "Next": "ComposeFirst"
    },
    "ComposeFirst": {
      "Type": "Task",
      "Comment": "Falls back to the versioned template inside the function; never fails on LLM errors.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {"FunctionName": "${ComposeFunctionArn}", "Payload": {"input.$": "$", "step": 1}},
      "ResultSelector": {"copy.$": "$.Payload"},
      "ResultPath": "$.copy1",
      "TimeoutSeconds": 60,
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 4}],
      "Next": "SendFirst"
    },
    "SendFirst": {
      "Type": "Task",
      "Comment": "Idempotent on event_id:step, so retries cannot double-send.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {"FunctionName": "${SendFunctionArn}", "Payload": {"input.$": "$", "step": 1}},
      "ResultPath": "$.send1",
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2.0, "MaxAttempts": 8}],
      "Next": "WaitForEngagement"
    },
    "WaitForEngagement": {
      "Type": "Task",
      "Comment": "Stores the task token; POST /v1/notifications/{id}/engagement calls SendTaskSuccess.",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {"FunctionName": "${StoreTokenFunctionArn}", "Payload": {"workflow_id.$": "$$.Execution.Name", "task_token.$": "$$.Task.Token"}},
      "TimeoutSeconds": 172800,
      "ResultPath": "$.engagement",
      "Retry": [{"ErrorEquals": ["Lambda.ServiceException"], "IntervalSeconds": 1, "BackoffRate": 2.0, "MaxAttempts": 3}],
      "Catch": [{"ErrorEquals": ["States.Timeout"], "ResultPath": "$.engagementTimeout", "Next": "HasEscalationChannel"}],
      "Next": "Engaged"
    },
    "Engaged": {"Type": "Succeed"},
    "HasEscalationChannel": {
      "Type": "Choice",
      "Choices": [{"And": [{"Variable": "$.planResult.plan.escalation_channel", "IsPresent": true}, {"Variable": "$.planResult.plan.escalation_channel", "IsNull": false}], "Next": "ComposeEscalation"}],
      "Default": "Completed"
    },
    "ComposeEscalation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {"FunctionName": "${ComposeFunctionArn}", "Payload": {"input.$": "$", "step": 2}},
      "ResultSelector": {"copy.$": "$.Payload"},
      "ResultPath": "$.copy2",
      "TimeoutSeconds": 60,
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 4}],
      "Next": "SendEscalation"
    },
    "SendEscalation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {"FunctionName": "${SendFunctionArn}", "Payload": {"input.$": "$", "step": 2}},
      "ResultPath": "$.send2",
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2.0, "MaxAttempts": 8}],
      "Next": "Completed"
    },
    "Completed": {"Type": "Succeed"}
  }
}
