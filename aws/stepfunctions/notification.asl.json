{
  "Comment": "Executable notify-flow workflow. DefinitionSubstitutions are populated by scripts/deploy_stepfunctions.py.",
  "StartAt": "SelectChannel",
  "States": {
    "SelectChannel": {
      "Type": "Task",
      "Resource": "${SelectChannelFunctionArn}",
      "TimeoutSeconds": 30,
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2.0, "MaxAttempts": 3, "MaxDelaySeconds": 8, "JitterStrategy": "FULL"}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.caught_error", "Next": "CaughtFailure"}],
      "Next": "ShouldSend"
    },
    "ShouldSend": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.plan.skip", "BooleanEquals": true, "Next": "Skipped"}],
      "Default": "CheckQuietHours"
    },
    "CheckQuietHours": {
      "Type": "Task",
      "Resource": "${QuietHoursFunctionArn}",
      "TimeoutSeconds": 30,
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2.0, "MaxAttempts": 3, "MaxDelaySeconds": 8, "JitterStrategy": "FULL"}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.caught_error", "Next": "CaughtFailure"}],
      "Next": "WaitForQuietHours"
    },
    "WaitForQuietHours": {"Type": "Wait", "SecondsPath": "$.quiet_wait_seconds", "Next": "PersonalizeFirst"},
    "PersonalizeFirst": {
      "Type": "Task",
      "Resource": "${PersonalizeFunctionArn}",
      "TimeoutSeconds": 30,
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2.0, "MaxAttempts": 3, "MaxDelaySeconds": 8, "JitterStrategy": "FULL"}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.caught_error", "Next": "CaughtFailure"}],
      "Next": "SendFirst"
    },
    "SendFirst": {
      "Type": "Task",
      "Resource": "${SendFunctionArn}",
      "TimeoutSeconds": 30,
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2.0, "MaxAttempts": 8, "MaxDelaySeconds": 30, "JitterStrategy": "FULL"}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.caught_error", "Next": "CaughtFailure"}],
      "Next": "WaitForEngagementWindow"
    },
    "WaitForEngagementWindow": {"Type": "Wait", "SecondsPath": "$.engagement_wait_s", "Next": "CheckEngagement"},
    "CheckEngagement": {
      "Type": "Task",
      "Resource": "${EngagementFunctionArn}",
      "TimeoutSeconds": 30,
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2.0, "MaxAttempts": 3, "MaxDelaySeconds": 8, "JitterStrategy": "FULL"}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.caught_error", "Next": "CaughtFailure"}],
      "Next": "WasEngaged"
    },
    "WasEngaged": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.engaged", "BooleanEquals": true, "Next": "Completed"}],
      "Default": "CanEscalate"
    },
    "CanEscalate": {
      "Type": "Choice",
      "Choices": [
        {"Variable": "$.plan.escalation_channel", "IsPresent": false, "Next": "Completed"},
        {"Variable": "$.plan.escalation_channel", "IsNull": true, "Next": "Completed"},
        {"Variable": "$.campaign", "StringEquals": "pain_checkin", "Next": "Completed"}
      ],
      "Default": "PrepareEscalation"
    },
    "PrepareEscalation": {
      "Type": "Task",
      "Resource": "${EscalationFunctionArn}",
      "TimeoutSeconds": 30,
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2.0, "MaxAttempts": 3, "MaxDelaySeconds": 8, "JitterStrategy": "FULL"}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.caught_error", "Next": "CaughtFailure"}],
      "Next": "PersonalizeEscalation"
    },
    "PersonalizeEscalation": {
      "Type": "Task",
      "Resource": "${PersonalizeFunctionArn}",
      "TimeoutSeconds": 30,
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2.0, "MaxAttempts": 3, "MaxDelaySeconds": 8, "JitterStrategy": "FULL"}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.caught_error", "Next": "CaughtFailure"}],
      "Next": "SendEscalation"
    },
    "SendEscalation": {
      "Type": "Task",
      "Resource": "${SendFunctionArn}",
      "TimeoutSeconds": 30,
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2.0, "MaxAttempts": 8, "MaxDelaySeconds": 30, "JitterStrategy": "FULL"}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.caught_error", "Next": "CaughtFailure"}],
      "Next": "Completed"
    },
    "Skipped": {"Type": "Succeed"},
    "Completed": {"Type": "Succeed"},
    "CaughtFailure": {
      "Type": "Pass",
      "Parameters": {"status": "caught", "error.$": "$.caught_error", "event_id.$": "$.event_id", "correlation_id.$": "$.correlation_id"},
      "End": true
    }
  }
}
